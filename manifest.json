{
  "manifest_version": 2,
  "name": "Ollama Assistant",
  "version": "1.0.0",
  "description": "Summarize pages and ask questions using a local Ollama server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ollama-assistant@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Ollama Assistant"
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Ollama Assistant"
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
